# Read-only Maroma API credentials (server-side only)
MAROMA_API_BASE_URL=https://staging-api.example.com
MAROMA_CONSUMER_KEY=replace_with_readonly_consumer_key
MAROMA_CONSUMER_SECRET=replace_with_readonly_consumer_secret

# Extra safety: always block production domains.
# Comma-separated hostnames (no protocol).
MAROMA_BLOCKED_HOSTS=maroma.com,www.maroma.com,api.maroma.com

# Allowlist for outbound API hosts.
# If empty, MAROMA_API_BASE_URL host is used.
MAROMA_ALLOWED_HOSTS=staging-api.example.com

# --- Site roles (admin vs user) ---
# Long random string used to sign session cookies (HMAC).
MAROMA_SESSION_SECRET=replace_with_long_random_secret

# JSON array of bootstrap accounts. Prefer creating/resetting users in /admin/users (stored hashed).
# If set here, passwords may be plain text until first successful login upgrades them to a stored hash.
# Restrict env access. role: "admin" may use /admin; "production" fulfillment; "user" account only.
# MAROMA_AUTH_USERS=[{"email":"editor@example.com","password":"replace-me","role":"admin"},{"email":"reader@example.com","password":"replace-me","role":"user"}]

# --- Canvas image storage (Firebase Storage) ---
# Create a Firebase project, enable Storage, and generate a service account key.
# Option A — individual vars (recommended on Vercel):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# Option B — full service account JSON in one var:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Legacy Vercel Blob token (optional — only to migrate existing canvas images)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Public URL for newsletter tracking links (recommended in production).
# NEXT_PUBLIC_SITE_URL=https://your-preview.vercel.app


# Hide admin chrome (top bar, floating homepage panel, in-page edit triggers) for client demos.
# Set to false or remove to restore admin UI.
NEXT_PUBLIC_HIDE_ADMIN_UI=true

# Review mode: show feedback markers site-wide (set to false to disable)
NEXT_PUBLIC_REVIEW_MODE=true

# --- Commerce (server cart / stock) ---
# Uses the same Vercel KV credentials as auth/newsletter when set (required on Vercel for admin layout saves):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Without KV, homepage admin layout saves only persist in local dev (data/hero-media-layout.json).

# Order confirmation emails (falls back to NEWSLETTER_FROM_EMAIL)
# ORDER_FROM_EMAIL=orders@yourdomain.com
# Production gift-set instructions (falls back to ORDER_FROM_EMAIL / NEWSLETTER_FROM_EMAIL)
# ORDER_PRODUCTION_EMAIL=production@yourdomain.com
# Product catalog edits persist to KV (maroma:product-catalog-edits) when configured, else data/product-catalog-edits.json locally

# Razorpay webhook (enable when payment is connected)
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Storefront checkout (CCAvenue). Set in Vercel only. Use the https://maromashopping.com key pair.
# CCAVENUE_MERCHANT_ID=
# CCAVENUE_ACCESS_CODE=
# CCAVENUE_WORKING_KEY=
# CCAVENUE_STORE_URL=https://maromashopping.com
# Required for B2B portal “Pay now” (Razorpay Checkout). Without these keys,
# clients can still use Place order (invoice).

# --- Newsletter email (Postmark) ---
# Server token from Postmark → Server → API tokens
# POSTMARK_SERVER_TOKEN=your-postmark-server-token
# Verified sender (must match Postmark Sender Signatures)
# NEWSLETTER_FROM_EMAIL=production@miraculousmedia.in
# Long random string for signed tracking/unsubscribe links
# NEWSLETTER_TRACKING_SECRET=replace_with_long_random_secret
# Campaign sends (default broadcast). Test sends use outbound unless overridden.
# POSTMARK_MESSAGE_STREAM=broadcast
# POSTMARK_TEST_MESSAGE_STREAM=outbound
